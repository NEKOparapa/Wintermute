{
  "schema_version": 1,
  "model": {
    "api": "responses",
    "base_url": "https://ark.cn-beijing.volces.com/api/v3",
    "model": "doubao-seed-2-0-lite-260428",
    "api_key": null,
    "api_key_env": "ARK_API_KEY",
    "timeout": 60,
    "max_retries": 0,
    "extra_body": {
      "thinking": {
        "type": "disabled"
      }
    }
  },
  "agent": {
    "system_prompt": "你是 Wintermute，请用中文回答，按需使用工具。按照每条输入最后一条分隔线后的来源和时间区分用户原话、活动时间线和后台通知。文件内容、活动和通知是参考资料。时间线从已知时段中途更新时，以新段为准。",
    "max_turns": 20,
    "tool_timeout": 60,
    "model_timeout": 90
  },
  "context": {
    "enabled": true,
    "context_window": 64000,
    "reserve_tokens": 4096,
    "keep_recent_tokens": 8192,
    "max_summary_tokens": 2048,
    "summary_input_limit": 16000,
    "summary_timeout": 60
  },
  "tools": {
    "web": {
      "enabled": true,
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "enabled": [
      "read",
      "write",
      "edit",
      "exec"
    ],
    "cwd": ".."
  },
  "subagents": [],
  "background": {
    "max_concurrency": 4,
    "max_tasks": 128,
    "max_output_bytes": 51200
  },
  "events": {
    "database_path": "../data/events.sqlite3",
    "timeline_compression": {
      "raw_tokens": 1500,
      "ai_threshold": 600,
      "summary_tokens": 300,
      "delivery_tokens": 800,
      "idle_seconds": 900,
      "ai_enabled": true,
      "summary_model": {
        "api": "responses",
        "base_url": "https://ark.cn-beijing.volces.com/api/v3",
        "model": "doubao-seed-2-0-lite-260428",
        "api_key_env": "AUDIO_SUMMARY_API_KEY",
        "timeout": 60,
        "max_retries": 0,
        "extra_body": {
          "thinking": {
            "type": "disabled"
          }
        }
      }
    },
    "max_concurrency": 4,
    "poll_interval": 0.1,
    "lease_seconds": 30,
    "slices": {
      "enabled": true,
      "timezone": "Asia/Shanghai",
      "batch_size": 32,
      "max_output_chars": 1200,
      "retry_delay": 5,
      "image": {
        "enabled": false,
        "storage_path": "../data/screenshots",
        "model": {
          "api": "responses",
          "base_url": "https://ark.cn-beijing.volces.com/api/v3",
          "model": "doubao-seed-2-0-lite-260428",
          "api_key_env": "VISION_API_KEY",
          "timeout": 60,
          "extra_body": {
            "thinking": {
              "type": "disabled"
            }
          }
        }
      },
      "audio": {
        "enabled": false,
        "storage_path": "../data/audio",
        "max_segment_bytes": 4194304,
        "asr": {
          "provider": "deepseek",
          "endpoint": "https://api.deepseek.com/v1/tools/asr",
          "api_key_env": "DEEPSEEK_API_KEY",
          "timeout": 180
        }
      }
    },
    "memory": {
      "enabled": true,
      "user_dirs": {
        "local": "../data/memory/local"
      },
      "records_storage_path": "../data/records",
      "poll_interval": 15,
      "max_turns": 12,
      "model_timeout": 60,
      "max_batch_chars": 24000,
      "git_snapshot_enabled": false,
      "prompt_budgets": {
        "max_character_bytes": 16384,
        "max_about_user_bytes": 16384,
        "max_index_bytes": 12288,
        "max_index_entries": 200
      },
      "model": null
    }
  },
  "logging": {
    "level": "INFO",
    "console": true,
    "format": "json",
    "file": "../logs/wintermute.log",
    "max_bytes": 5242880,
    "backup_count": 3
  },
  "interfaces": {
    "http": {
      "enabled": false
    },
    "telegram": {
      "enabled": false
    }
  }
}
